# Copie para .env e preencha
GROQ_API_KEY=sua_chave_groq_aqui
# llama-3.3-70b-versatile foi descontinuado em 08/2026. Use um destes:
# - openai/gpt-oss-20b (leve, barato, recomendado p/ resumo)
# - openai/gpt-oss-120b (maior qualidade)
# - llama-3.3-70b-specdec (substituto direto do versatile)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.3-70b-specdec

# Seu número WhatsApp (só dígitos com DDI, ex: 2449XXXXXXXX para Angola, 55119XXXXXXXX para BR)
MY_PHONE=244900000000
# Sessão Neonize (SQLite persistente — após 1º QR code não precisa escanear de novo)
WHATSAPP_DB=./whatsapp.db
WHATSAPP_NAME=ai_news_bot

# Fuso para o scheduler (Angola = Africa/Luanda, UTC+1)
TIMEZONE=Africa/Luanda
# Horários do digest (cron hour). Padrão: 8,13,19,23
DIGEST_HOURS=8,13,19,23

# Filtro de relevância via Groq (0-10)
SCORE_SEND_NOW=8
SCORE_DIGEST_MIN=5
MAX_ITEMS_PER_RUN=15
MAX_DIGEST_ITEMS=5
